# Copy to .env for local runs:  cp .env.example .env
# .env is gitignored. Never commit real values — the session string alone is
# enough to fully control the Telegram account.

# From https://my.telegram.org → API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Generate with: python tools/gen_session.py
TELEGRAM_SESSION=

# Optional: override config.json without editing it.
# V2TG_SCHEDULE__BATCH_SIZE=10
# V2TG_SCHEDULE__WINDOW_HOURS=24
# V2TG_RUNTIME__DRY_RUN=true
# V2TG_CHANNELS=[{"username":"@one","daily_quota":100}]
